# Clé API Google Maps (Places API) pour l'autocomplétion d'adresse
# du formulaire de lead. Sans cette clé, le champ adresse reste
# une saisie libre classique.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Clé API Resend (https://resend.com) pour l'envoi de l'email de
# notification à chaque nouveau prospect. Sans cette clé, le lead est
# toujours validé et enregistré côté serveur, mais aucun email n'est
# envoyé (un avertissement est loggé côté serveur).
RESEND_API_KEY=

# Adresse qui reçoit la notification de chaque nouveau prospect.
LEAD_NOTIFICATION_EMAIL=soleilpourtouspro@gmail.com

# Adresse d'expédition affichée. "onboarding@resend.dev" fonctionne sans
# configuration mais n'est pas fiable en délivrabilité — une fois un
# domaine vérifié sur Resend, utiliser plutôt une adresse de ce domaine,
# par ex. "Soleil Pour Tous <contact@soleilpourtous.fr>".
RESEND_FROM_EMAIL=Soleil Pour Tous <onboarding@resend.dev>
