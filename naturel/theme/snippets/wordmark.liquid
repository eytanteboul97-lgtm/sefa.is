{%- comment -%}
  The NATUREL wordmark. Always prefers the uploaded original logo so its
  typography is preserved; the text version is only a fallback.
  Params: light (bool) — prefer the light logo on photography; width
{%- endcomment -%}
{%- liquid
  assign logo = settings.logo
  if light and settings.logo_light != blank
    assign logo = settings.logo_light
  endif
  assign w = width | default: settings.logo_width
-%}
{%- if logo != blank -%}
  {{ logo | image_url: width: 900 | image_tag: width: w, alt: shop.name, class: class, loading: loading, sizes: '(min-width: 990px) 240px, 50vw' }}
{%- else -%}
  <span class="wordmark{% if class %} {{ class }}{% endif %}">{{ shop.name }}</span>
{%- endif -%}
