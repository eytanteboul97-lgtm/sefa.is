<section class="section section--tight">
  <div class="container container--text">
    {%- if section.settings.heading != blank -%}<h2 class="h2" style="margin-bottom: 32px">{{ section.settings.heading }}</h2>{%- endif -%}
    {%- form 'contact', id: 'ContactForm' -%}
      {%- if form.posted_successfully? -%}
        <p class="errors" role="status" style="border-color: var(--c-ocean)">{{ 'contact.success' | t }}</p>
      {%- elsif form.errors -%}
        <div class="errors" role="alert">{{ form.errors | default_errors }}</div>
      {%- endif -%}
      <div class="field">
        <label for="ContactName">{{ 'contact.name' | t }}</label>
        <input id="ContactName" type="text" name="contact[{{ 'contact.name' | t }}]" autocomplete="name" value="{{ form.name }}">
      </div>
      <div class="field">
        <label for="ContactEmail">{{ 'contact.email' | t }} *</label>
        <input id="ContactEmail" type="email" name="contact[email]" autocomplete="email" required value="{{ form.email }}">
      </div>
      <div class="field">
        <label for="ContactBody">{{ 'contact.message' | t }}</label>
        <textarea id="ContactBody" name="contact[body]">{{ form.body }}</textarea>
      </div>
      <button type="submit" class="btn btn--solid">{{ 'contact.send' | t }}</button>
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Formulaire de contact",
  "settings": [{ "type": "text", "id": "heading", "label": "Titre", "default": "Écrivez-nous" }],
  "presets": [{ "name": "Formulaire de contact" }]
}
{% endschema %}
