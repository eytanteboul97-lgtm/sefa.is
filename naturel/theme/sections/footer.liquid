<footer class="footer on-media">
  <div class="container">
    <div class="footer__top">
      <div class="footer__brand">
        {% render 'emblem', width: 52 %}
        {%- if settings.logo_light != blank -%}
          {% render 'wordmark', light: true, width: 150 %}
        {%- else -%}
          <span class="wordmark">{{ shop.name }}</span>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <p>{{ section.settings.text }}</p>
        {%- endif -%}
        {%- if settings.social_instagram != blank or settings.social_tiktok != blank or settings.social_pinterest != blank -%}
          <ul class="footer__social list-reset" role="list">
            {%- if settings.social_instagram != blank -%}<li><a class="icon-btn" href="{{ settings.social_instagram }}" target="_blank" rel="noopener">{% render 'icon', name: 'instagram' %}<span class="visually-hidden">Instagram</span></a></li>{%- endif -%}
            {%- if settings.social_tiktok != blank -%}<li><a class="icon-btn" href="{{ settings.social_tiktok }}" target="_blank" rel="noopener">{% render 'icon', name: 'tiktok' %}<span class="visually-hidden">TikTok</span></a></li>{%- endif -%}
            {%- if settings.social_pinterest != blank -%}<li><a class="icon-btn" href="{{ settings.social_pinterest }}" target="_blank" rel="noopener">{% render 'icon', name: 'pinterest' %}<span class="visually-hidden">Pinterest</span></a></li>{%- endif -%}
          </ul>
        {%- endif -%}
      </div>

      <div class="footer__cols">
        {%- for block in section.blocks -%}
          {%- assign menu = linklists[block.settings.menu] -%}
          {%- if menu.links.size > 0 -%}
            <nav aria-label="{{ block.settings.heading | default: menu.title | escape }}" {{ block.shopify_attributes }}>
              <h2 class="footer__heading">{{ block.settings.heading | default: menu.title }}</h2>
              <ul class="footer__list list-reset" role="list">
                {%- for link in menu.links -%}
                  <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                {%- endfor -%}
              </ul>
            </nav>
          {%- endif -%}
        {%- endfor -%}

        {%- if section.settings.show_policies and shop.policies.size > 0 -%}
          <nav aria-label="{{ 'footer.legal' | t }}">
            <h2 class="footer__heading">{{ 'footer.legal' | t }}</h2>
            <ul class="footer__list list-reset" role="list">
              {%- for policy in shop.policies -%}
                <li><a href="{{ policy.url }}">{{ policy.title }}</a></li>
              {%- endfor -%}
            </ul>
          </nav>
        {%- endif -%}
      </div>
    </div>

    <div class="footer__bottom">
      <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}{% if section.settings.legal_line != blank %} — {{ section.settings.legal_line }}{% endif %}</p>

      {%- if localization.available_countries.size > 1 or localization.available_languages.size > 1 -%}
        {%- form 'localization', id: 'FooterLocalization' -%}
          {%- if localization.available_countries.size > 1 -%}
            <label class="visually-hidden" for="FooterCountry">{{ 'footer.country' | t }}</label>
            <select id="FooterCountry" name="country_code" data-autosubmit>
              {%- for country in localization.available_countries -%}
                <option value="{{ country.iso_code }}"{% if country.iso_code == localization.country.iso_code %} selected{% endif %}>{{ country.name }} ({{ country.currency.iso_code }} {{ country.currency.symbol }})</option>
              {%- endfor -%}
            </select>
          {%- endif -%}
          {%- if localization.available_languages.size > 1 -%}
            <label class="visually-hidden" for="FooterLanguage">{{ 'footer.language' | t }}</label>
            <select id="FooterLanguage" name="language_code" data-autosubmit>
              {%- for language in localization.available_languages -%}
                <option value="{{ language.iso_code }}"{% if language.iso_code == localization.language.iso_code %} selected{% endif %}>{{ language.endonym_name | capitalize }}</option>
              {%- endfor -%}
            </select>
          {%- endif -%}
          <noscript><button type="submit">OK</button></noscript>
        {%- endform -%}
      {%- endif -%}

      {%- if section.settings.show_payment_icons -%}
        <ul class="footer__payments list-reset" role="list" aria-label="{{ 'footer.payment_methods' | t }}">
          {%- for type in shop.enabled_payment_types -%}
            <li>{{ type | payment_type_svg_tag }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Pied de page",
  "enabled_on": { "groups": ["footer"] },
  "settings": [
    {
      "type": "textarea",
      "id": "text",
      "label": "Texte de marque",
      "default": "Inspirée par la nature, façonnée par le détail."
    },
    {
      "type": "checkbox",
      "id": "show_policies",
      "label": "Afficher les politiques Shopify",
      "info": "Liste automatique de Paramètres > Politiques : CGV, remboursement, confidentialité, livraison, mentions légales, coordonnées.",
      "default": true
    },
    {
      "type": "text",
      "id": "legal_line",
      "label": "Mention commerciale",
      "info": "Ex. raison sociale et SIRET. [À COMPLÉTER]"
    },
    { "type": "checkbox", "id": "show_payment_icons", "label": "Afficher les moyens de paiement", "default": true }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu",
      "limit": 3,
      "settings": [
        { "type": "text", "id": "heading", "label": "Titre" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    }
  ]
}
{% endschema %}
