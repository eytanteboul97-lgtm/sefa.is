<div class="container">
  <header class="page-head page-head--center">
    <p class="eyebrow">{{ 'collections.eyebrow' | t }}</p>
    <h1 class="h1 h-caps">{{ collection.title }}</h1>
    {%- if collection.description != blank -%}
      <div class="lede rte" style="max-width: 56ch">{{ collection.description }}</div>
    {%- endif -%}
  </header>

  {%- paginate collection.products by section.settings.per_page -%}
    <div class="toolbar">
      <span>{{ 'collections.count' | t: count: collection.products_count }}</span>
      {%- if section.settings.show_sort -%}
        <form method="get" data-sort-form>
          <label for="SortBy" class="visually-hidden">{{ 'collections.sort_by' | t }}</label>
          {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
          <select name="sort_by" id="SortBy" data-autosubmit>
            {%- for option in collection.sort_options -%}
              <option value="{{ option.value | escape }}"{% if option.value == sort_by %} selected{% endif %}>{{ option.name | escape }}</option>
            {%- endfor -%}
          </select>
          <noscript><button type="submit">OK</button></noscript>
        </form>
      {%- endif -%}
    </div>

    {%- if collection.products.size > 0 -%}
      <ul class="grid list-reset" role="list" style="--cols: {{ section.settings.columns }}">
        {%- for product in collection.products -%}
          <li>{% render 'product-card', product: product, index: forloop.index0, show_quick_add: section.settings.quick_add %}</li>
        {%- endfor -%}
      </ul>
    {%- else -%}
      <p class="text-center lede" style="padding-block: 10vh">{{ 'collections.empty' | t }}</p>
    {%- endif -%}

    {%- if paginate.pages > 1 -%}
      {% render 'pagination', paginate: paginate %}
    {%- endif -%}
  {%- endpaginate -%}
</div>
<div style="height: var(--section-space)"></div>

{% schema %}
{
  "name": "Collection",
  "settings": [
    { "type": "range", "id": "per_page", "label": "Produits par page", "min": 8, "max": 48, "step": 4, "default": 24 },
    { "type": "range", "id": "columns", "label": "Colonnes (grand écran)", "min": 3, "max": 5, "step": 1, "default": 5 },
    { "type": "checkbox", "id": "show_sort", "label": "Tri", "default": true },
    { "type": "checkbox", "id": "quick_add", "label": "Ajout rapide (produits sans variante)", "default": true }
  ]
}
{% endschema %}
