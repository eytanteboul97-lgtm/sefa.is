<div class="container container--text section--tight" style="max-width: 480px">
  <h1 class="h1 text-center" style="margin-bottom: 40px">{{ 'customer.register.title' | t }}</h1>
  {%- form 'create_customer', novalidate: 'novalidate' -%}
    {%- if form.errors -%}<div class="errors" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
    <div class="field"><label for="RegisterFirstName">{{ 'customer.first_name' | t }}</label><input type="text" name="customer[first_name]" id="RegisterFirstName" autocomplete="given-name"></div>
    <div class="field"><label for="RegisterLastName">{{ 'customer.last_name' | t }}</label><input type="text" name="customer[last_name]" id="RegisterLastName" autocomplete="family-name"></div>
    <div class="field"><label for="RegisterEmail">{{ 'customer.email' | t }}</label><input type="email" name="customer[email]" id="RegisterEmail" autocomplete="email" required></div>
    <div class="field"><label for="RegisterPassword">{{ 'customer.password' | t }}</label><input type="password" name="customer[password]" id="RegisterPassword" autocomplete="new-password" required></div>
    <label class="check" style="margin-bottom: 24px"><input type="checkbox" name="customer[accepts_marketing]" value="true"> {{ 'customer.register.marketing' | t }}</label>
    <button type="submit" class="btn btn--solid btn--block">{{ 'customer.register.submit' | t }}</button>
  {%- endform -%}
</div>

{% schema %}
{ "name": "Inscription", "settings": [] }
{% endschema %}
