<div class="container cart-empty" style="min-height: 100vh; align-content: center; padding-block: 64px">
  {% render 'emblem', width: 72 %}
  {% render 'wordmark', loading: 'eager' %}
  {%- if section.settings.heading != blank -%}<h1 class="h2 h-caps" style="margin-top: 24px">{{ section.settings.heading }}</h1>{%- endif -%}
  {%- if shop.password_message != blank -%}<p class="lede">{{ shop.password_message }}</p>{%- endif -%}

  {%- form 'customer', class: 'newsletter__form' -%}
    <input type="hidden" name="contact[tags]" value="prelaunch">
    <div class="field-line">
      <label for="PasswordNewsletter" class="visually-hidden">{{ 'newsletter.label' | t }}</label>
      <input id="PasswordNewsletter" type="email" name="contact[email]" required autocomplete="email" placeholder="{{ 'newsletter.label' | t }}">
      <button type="submit">{{ 'newsletter.button' | t }}</button>
    </div>
    {%- if form.posted_successfully? -%}<p class="form-message" role="status">{{ 'newsletter.success' | t }}</p>{%- endif -%}
  {%- endform -%}

  <details style="margin-top: 48px">
    <summary class="small muted" style="cursor: pointer">{{ 'password.owner' | t }}</summary>
    {%- form 'storefront_password', class: 'newsletter__form' -%}
      {%- if form.errors -%}<div class="errors" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
      <div class="field-line">
        <label for="Password" class="visually-hidden">{{ 'password.label' | t }}</label>
        <input id="Password" type="password" name="password" autocomplete="current-password" placeholder="{{ 'password.label' | t }}">
        <button type="submit">{{ 'password.enter' | t }}</button>
      </div>
    {%- endform -%}
  </details>
</div>

{% schema %}
{
  "name": "Page mot de passe",
  "settings": [{ "type": "text", "id": "heading", "label": "Titre", "default": "Bientôt" }]
}
{% endschema %}
