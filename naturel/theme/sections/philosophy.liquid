{%- assign bg = section.settings.background -%}
<section class="section{% if bg != 'none' %} section--{{ bg }}{% endif %}">
  <div class="container">
    <div class="philo{% if section.settings.reverse %} philo--reverse{% endif %}">
      <div class="philo__visual">
        <div class="philo__main media media--4-5 reveal-media reveal">
          {%- if section.settings.image != blank -%}
            {{ section.settings.image | image_url: width: 1600 | image_tag: widths: '600, 900, 1200, 1600', sizes: '(min-width: 750px) 48vw, 100vw', loading: 'lazy' }}
          {%- else -%}
            {% render 'placeholder', label: 'Matière naturelle : lin, sable, toile de la casquette en gros plan' %}
          {%- endif -%}
        </div>
        <div class="philo__detail media media--1-1 reveal-media reveal" style="--d: 2">
          {%- if section.settings.image_2 != blank -%}
            {{ section.settings.image_2 | image_url: width: 900 | image_tag: widths: '400, 600, 900', sizes: '22vw', loading: 'lazy' }}
          {%- else -%}
            {% render 'placeholder', tone: 'stone', label: 'Détail : écusson N' %}
          {%- endif -%}
        </div>
      </div>

      <div class="philo__text">
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow eyebrow--rule reveal">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="h2 reveal" style="--d: 1">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="quote reveal" style="--d: 2">{{ section.settings.text }}</div>
        {%- endif -%}
        {%- if section.settings.body != blank -%}
          <div class="rte lede reveal" style="--d: 3">{{ section.settings.body }}</div>
        {%- endif -%}
        {%- if section.settings.link_label != blank and section.settings.link != blank -%}
          <a href="{{ section.settings.link }}" class="link reveal" style="--d: 4">{{ section.settings.link_label }} {% render 'icon', name: 'arrow' %}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Philosophie",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Photographie principale", "info": "Matière naturelle, format portrait." },
    { "type": "image_picker", "id": "image_2", "label": "Photographie de détail", "info": "Petite image en superposition (ordinateur)." },
    { "type": "checkbox", "id": "reverse", "label": "Inverser la composition", "default": false },
    {
      "type": "select",
      "id": "background",
      "label": "Fond",
      "options": [
        { "value": "none", "label": "Sable" },
        { "value": "paper", "label": "Blanc cassé" },
        { "value": "beige", "label": "Beige chaud" }
      ],
      "default": "none"
    },
    { "type": "text", "id": "eyebrow", "label": "Surtitre", "default": "Notre philosophie" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Simply Naturel" },
    {
      "type": "richtext",
      "id": "text",
      "label": "Citation",
      "default": "<p>« Inspirée par la nature, façonnée par le détail. NATUREL célèbre une élégance instinctive, libre et intemporelle. »</p>"
    },
    { "type": "richtext", "id": "body", "label": "Texte complémentaire" },
    { "type": "text", "id": "link_label", "label": "Lien — libellé", "default": "Découvrir notre histoire" },
    { "type": "url", "id": "link", "label": "Lien", "info": "Ex. la page « Notre histoire »." }
  ],
  "presets": [{ "name": "Philosophie" }]
}
{% endschema %}
