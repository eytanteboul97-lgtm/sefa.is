<div class="container section--tight">
  <header class="page-head" style="padding-top: 0">
    <p class="eyebrow">{{ 'customer.account.title' | t }}</p>
    <h1 class="h1">{{ customer.first_name | default: customer.email }}</h1>
    <a href="{{ routes.account_logout_url }}" class="link" style="justify-self: start">{{ 'customer.account.logout' | t }}</a>
  </header>
  <div class="cart-page">
    <div>
      <h2 class="h3" style="margin-bottom: 24px">{{ 'customer.orders.title' | t }}</h2>
      {%- paginate customer.orders by 20 -%}
        {%- if customer.orders.size > 0 -%}
          <ul class="list-reset registry" role="list">
            {%- for order in customer.orders -%}
              <li>
                <a class="registry__row" href="{{ order.customer_url }}" style="grid-template-columns: 1fr auto auto">
                  <span class="registry__name">{{ order.name }}</span>
                  <span class="small">{{ order.created_at | time_tag: format: 'date' }} · {{ order.fulfillment_status_label }}</span>
                  <span>{{ order.total_price | money }}</span>
                </a>
              </li>
            {%- endfor -%}
          </ul>
        {%- else -%}
          <p class="muted">{{ 'customer.orders.none' | t }}</p>
        {%- endif -%}
        {%- if paginate.pages > 1 -%}{% render 'pagination', paginate: paginate %}{%- endif -%}
      {%- endpaginate -%}
    </div>
    <aside class="cart-page__summary">
      <h2 class="h3" style="margin-bottom: 16px">{{ 'customer.addresses.title' | t }}</h2>
      {%- if customer.default_address -%}{{ customer.default_address | format_address }}{%- endif -%}
      <p style="margin-top: 16px"><a href="{{ routes.account_addresses_url }}" class="link">{{ 'customer.addresses.manage' | t }} ({{ customer.addresses_count }})</a></p>
    </aside>
  </div>
</div>

{% schema %}
{ "name": "Compte", "settings": [] }
{% endschema %}
