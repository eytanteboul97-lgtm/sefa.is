{%- if section.settings.text != blank -%}
  <div class="announcement">
    {%- if section.settings.link != blank -%}
      <a href="{{ section.settings.link }}">{{ section.settings.text }}</a>
    {%- else -%}
      <p>{{ section.settings.text }}</p>
    {%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Bandeau d'information",
  "enabled_on": { "groups": ["header"] },
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Texte",
      "info": "Laissez vide pour masquer le bandeau. N'annoncez que des conditions réellement configurées dans Shopify (ex. livraison)."
    },
    { "type": "url", "id": "link", "label": "Lien" }
  ],
  "presets": [{ "name": "Bandeau d'information" }]
}
{% endschema %}
