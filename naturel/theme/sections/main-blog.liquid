<div class="container">
  <header class="page-head page-head--center">
    <p class="eyebrow">{{ 'blogs.eyebrow' | t }}</p>
    <h1 class="h1 h-caps">{{ blog.title }}</h1>
  </header>
  {%- paginate blog.articles by 9 -%}
    <ul class="blog-grid list-reset" role="list">
      {%- for article in blog.articles -%}
        <li class="article-card reveal" style="--d: {{ forloop.index0 | modulo: 3 }}">
          <a href="{{ article.url }}" class="media" tabindex="-1" aria-hidden="true">
            {%- if article.image -%}
              {{ article.image | image_url: width: 1100 | image_tag: widths: '500, 800, 1100', sizes: '(min-width: 1200px) 33vw, (min-width: 750px) 50vw, 100vw', loading: 'lazy', alt: '' }}
            {%- else -%}
              {% render 'placeholder', label: article.title %}
            {%- endif -%}
          </a>
          <p class="eyebrow">{{ article.published_at | time_tag: format: 'date' }}</p>
          <h2 class="article-card__title"><a href="{{ article.url }}">{{ article.title }}</a></h2>
          {%- if article.excerpt != blank -%}<div class="muted">{{ article.excerpt | strip_html | truncatewords: 26 }}</div>{%- endif -%}
        </li>
      {%- else -%}
        <li class="lede text-center">{{ 'blogs.empty' | t }}</li>
      {%- endfor -%}
    </ul>
    {%- if paginate.pages > 1 -%}{% render 'pagination', paginate: paginate %}{%- endif -%}
  {%- endpaginate -%}
</div>
<div style="height: var(--section-space)"></div>

{% schema %}
{ "name": "Journal", "settings": [] }
{% endschema %}
