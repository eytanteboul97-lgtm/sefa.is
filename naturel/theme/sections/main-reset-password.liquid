<div class="container container--text section--tight" style="max-width: 480px">
  <h1 class="h1 text-center" style="margin-bottom: 32px">{{ 'customer.reset.title' | t }}</h1>
  {%- form 'reset_customer_password' -%}
    {%- if form.errors -%}<div class="errors" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
    <div class="field"><label for="ResetPassword">{{ 'customer.password' | t }}</label><input type="password" name="customer[password]" id="ResetPassword" autocomplete="new-password" required></div>
    <div class="field"><label for="ResetPasswordConfirm">{{ 'customer.password_confirm' | t }}</label><input type="password" name="customer[password_confirmation]" id="ResetPasswordConfirm" autocomplete="new-password" required></div>
    <button type="submit" class="btn btn--solid btn--block">{{ 'customer.reset.submit' | t }}</button>
  {%- endform -%}
</div>

{% schema %}
{ "name": "Nouveau mot de passe", "settings": [] }
{% endschema %}
