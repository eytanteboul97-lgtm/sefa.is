{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign product_form_id = 'product-form-' | append: section.id
  assign series = product.metafields.custom.series.value
  assign edition_size = product.metafields.custom.edition_size.value
  assign first_image = product.featured_media
  if current_variant.featured_media
    assign first_image = current_variant.featured_media
  endif
-%}

<div class="container" data-product-section data-section="{{ section.id }}" data-url="{{ product.url }}">
  <div class="product">
    {%- comment -%} ---------- Gallery ---------- {%- endcomment -%}
    <div class="product-gallery" data-gallery-product>
      <ul class="product-gallery__list list-reset" role="list" data-media-list aria-label="{{ 'products.product.gallery' | t }}">
        {%- if product.media.size > 0 -%}
          {%- for media in product.media -%}
            <li class="product-gallery__item" data-media-id="{{ media.id }}" data-index="{{ forloop.index0 }}">
              <div class="media"{% if forloop.first and settings.animations_enabled and settings.page_transitions %} style="view-transition-name: pm-{{ product.id }}"{% endif %}>
                {%- case media.media_type -%}
                  {%- when 'image' -%}
                    {%- assign full = media | image_url: width: 2800 -%}
                    {%- if forloop.first -%}
                      {{ media | image_url: width: 2000 | image_tag: widths: '600, 900, 1200, 1600, 2000', sizes: '(min-width: 990px) 58vw, 100vw', loading: 'eager', fetchpriority: 'high', data-zoom: forloop.index0, data-full: full }}
                    {%- else -%}
                      {{ media | image_url: width: 1600 | image_tag: widths: '600, 900, 1200, 1600', sizes: '(min-width: 990px) 29vw, 100vw', loading: 'lazy', data-zoom: forloop.index0, data-full: full }}
                    {%- endif -%}
                  {%- when 'video' -%}
                    {{ media | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, controls: false, image_size: '1200x' }}
                  {%- when 'external_video' -%}
                    {{ media | external_video_url: autoplay: false | external_video_tag }}
                  {%- when 'model' -%}
                    {{ media | model_viewer_tag: image_size: '1200x', reveal: 'interaction', toggleable: true }}
                {%- endcase -%}
              </div>
            </li>
          {%- endfor -%}
        {%- else -%}
          <li class="product-gallery__item">
            <div class="media">{% render 'placeholder', label: 'Photographies HD du produit : face, profil, dos, écusson, visière, boucle, numérotation' %}</div>
          </li>
        {%- endif -%}
      </ul>
      {%- if product.media.size > 1 -%}
        <p class="product-gallery__counter" aria-hidden="true"><span data-media-current>1</span> / {{ product.media.size }}</p>
      {%- endif -%}
      {%- if product.media.size > 0 -%}
        <button type="button" class="icon-btn product-gallery__zoom" data-zoom-open="0">
          {% render 'icon', name: 'zoom' %}<span class="visually-hidden">{{ 'products.product.zoom' | t }}</span>
        </button>
      {%- endif -%}
    </div>

    {%- comment -%} ---------- Information ---------- {%- endcomment -%}
    <div class="product-info">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'title' -%}
            <div {{ block.shopify_attributes }}>
              {%- if series != blank -%}<p class="eyebrow" style="margin-bottom: 12px;">{{ series }}</p>{%- endif -%}
              <h1 class="product-info__title">{{ product.title }}</h1>
              {%- if block.settings.show_vendor and product.vendor != blank -%}<p class="small muted">{{ product.vendor }}</p>{%- endif -%}
            </div>

          {%- when 'price' -%}
            <div class="product-info__price" {{ block.shopify_attributes }}>
              <div data-price-wrapper>{% render 'price', product: product, variant: current_variant %}</div>
              <span class="tax">
                {%- if cart.taxes_included -%}{{ 'products.product.taxes_included' | t }}{%- else -%}{{ 'products.product.taxes_excluded' | t }}{%- endif -%}
                {%- if shop.shipping_policy.body != blank -%} · <a href="{{ shop.shipping_policy.url }}" style="text-decoration: underline">{{ 'products.product.shipping_link' | t }}</a>{%- endif -%}
              </span>
              {%- assign installments_id = 'installments-' | append: section.id -%}
              {%- form 'product', product, id: installments_id -%}
                <input type="hidden" name="id" value="{{ current_variant.id }}">
                {{ form | payment_terms }}
              {%- endform -%}
            </div>

          {%- when 'edition' -%}
            {%- assign edition_number = current_variant.metafields.custom.edition_number.value | default: product.metafields.custom.edition_number.value -%}
            {%- if edition_size or edition_number -%}
              <div class="edition" {{ block.shopify_attributes }}>
                {%- if edition_size -%}<span>{{ 'products.product.edition_of' | t: count: edition_size }}</span>{%- endif -%}
                <span class="edition__no" data-edition-number{% unless edition_number %} hidden{% endunless %}>
                  {%- if edition_number -%}N° {{ edition_number }}{% if edition_size %} / {{ edition_size }}{% endif %}{%- endif -%}
                </span>
              </div>
            {%- endif -%}

          {%- when 'variant_picker' -%}
            {%- unless product.has_only_default_variant -%}
              <div class="variant-picker" data-variant-picker {{ block.shopify_attributes }}>
                {%- for option in product.options_with_values -%}
                  <fieldset class="option">
                    <legend>{{ option.name }}<span data-option-selected="{{ forloop.index0 }}">{{ option.selected_value }}</span></legend>
                    <div class="option__values">
                      {%- assign option_index = forloop.index0 -%}
                      {%- for value in option.values -%}
                        <div class="pill">
                          <input
                            type="radio"
                            id="{{ section.id }}-{{ option_index }}-{{ forloop.index0 }}"
                            name="{{ section.id }}-option-{{ option_index }}"
                            value="{{ value | escape }}"
                            data-option-index="{{ option_index }}"
                            {% if option.selected_value == value %}checked{% endif %}
                            {% unless value.available %}class="is-unavailable"{% endunless %}
                          >
                          <label for="{{ section.id }}-{{ option_index }}-{{ forloop.index0 }}">{{ value }}</label>
                        </div>
                      {%- endfor -%}
                    </div>
                  </fieldset>
                {%- endfor -%}
              </div>
            {%- endunless -%}

          {%- when 'colorways' -%}
            {%- assign siblings = block.settings.collection | default: product.collections.first -%}
            {%- if siblings and siblings.products_count > 1 -%}
              <div class="option" {{ block.shopify_attributes }}>
                <p><span class="eyebrow">{{ block.settings.heading }}</span> <span class="small muted">— {{ product.title }}</span></p>
                <ul class="swatches list-reset" role="list">
                  {%- for sibling in siblings.products limit: 24 -%}
                    {%- assign swatch = sibling.metafields.custom.swatch.value -%}
                    <li>
                      <a
                        href="{{ sibling.url }}"
                        class="swatch{% unless sibling.available %} swatch--sold{% endunless %}"
                        title="{{ sibling.title | escape }}{% unless sibling.available %} — {{ 'products.product.sold_out' | t }}{% endunless %}"
                        {% if sibling.id == product.id %}aria-current="true"{% endif %}
                      >
                        <span class="swatch__dot" style="position: relative;{% if swatch %} background: {{ swatch }};{% endif %}">
                          {%- if swatch == blank and sibling.featured_media -%}
                            {{ sibling.featured_media | image_url: width: 80, height: 80, crop: 'center' | image_tag: width: 26, height: 26, alt: '' }}
                          {%- endif -%}
                        </span>
                        <span class="visually-hidden">{{ sibling.title }}{% unless sibling.available %} — {{ 'products.product.sold_out' | t }}{% endunless %}</span>
                      </a>
                    </li>
                  {%- endfor -%}
                </ul>
              </div>
            {%- endif -%}

          {%- when 'buy_buttons' -%}
            <div {{ block.shopify_attributes }}>
              <p class="availability{% unless current_variant.available %} availability--out{% endunless %}" data-availability style="margin-bottom: 16px;">
                {%- render 'availability', variant: current_variant -%}
              </p>
              {%- form 'product', product, id: product_form_id, class: 'buy', novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
                <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>
                <button
                  type="submit"
                  name="add"
                  class="btn btn--solid btn--block"
                  data-add-button
                  {% unless current_variant.available %}disabled{% endunless %}
                >
                  <span data-add-label>
                    {%- if current_variant.available -%}{{ 'products.product.add_to_cart' | t }}{%- else -%}{{ 'products.product.sold_out' | t }}{%- endif -%}
                  </span>
                </button>
                {%- if block.settings.show_dynamic_checkout -%}
                  {{ form | payment_button }}
                {%- endif -%}
                <p class="form-message form-message--error" data-form-error role="alert" hidden></p>
              {%- endform -%}
            </div>

          {%- when 'description' -%}
            {%- if product.description != blank -%}
              <div class="rte" {{ block.shopify_attributes }}>{{ product.description }}</div>
            {%- endif -%}

          {%- when 'text' -%}
            {%- if block.settings.text != blank -%}
              <div class="rte small muted" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
            {%- endif -%}

          {%- when 'collapsible' -%}
            {%- liquid
              assign content = ''
              case block.settings.source
                when 'composition'
                  assign content = product.metafields.custom.composition.value | newline_to_br
                when 'care'
                  assign content = product.metafields.custom.care.value | newline_to_br
                else
                  assign content = block.settings.content
              endcase
              if block.settings.page != blank
                assign content = content | append: block.settings.page.content
              endif
            -%}
            {%- if content != blank or block.settings.show_policies -%}
              <div class="accordion" {{ block.shopify_attributes }}>
                <details{% if block.settings.open %} open{% endif %}>
                  <summary>{{ block.settings.heading }} {% render 'icon', name: 'plus' %}</summary>
                  <div class="accordion__content rte">
                    {{ content }}
                    {%- if block.settings.show_policies -%}
                      <p>
                        {%- if shop.shipping_policy.body != blank -%}<a href="{{ shop.shipping_policy.url }}">{{ shop.shipping_policy.title }}</a>{%- endif -%}
                        {%- if shop.shipping_policy.body != blank and shop.refund_policy.body != blank %} · {% endif -%}
                        {%- if shop.refund_policy.body != blank -%}<a href="{{ shop.refund_policy.url }}">{{ shop.refund_policy.title }}</a>{%- endif -%}
                      </p>
                    {%- endif -%}
                  </div>
                </details>
              </div>
            {%- endif -%}
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{%- comment -%} Mobile sticky add-to-cart: submits the main form via the form attribute. {%- endcomment -%}
<div class="sticky-buy" data-sticky-buy aria-hidden="true">
  <div class="sticky-buy__info">
    <span class="sticky-buy__title">{{ product.title }}</span>
    <span class="sticky-buy__price" data-sticky-price>{{ current_variant.price | money }}</span>
  </div>
  <button type="submit" form="{{ product_form_id }}" class="btn btn--solid" data-add-button tabindex="-1" {% unless current_variant.available %}disabled{% endunless %}>
    <span data-add-label>{%- if current_variant.available -%}{{ 'products.product.add_short' | t }}{%- else -%}{{ 'products.product.sold_out' | t }}{%- endif -%}</span>
  </button>
</div>

{%- comment -%} Zoom lightbox {%- endcomment -%}
<dialog class="lightbox" data-lightbox aria-label="{{ 'products.product.zoom' | t }}">
  <div class="lightbox__stage" data-lightbox-stage>
    <img alt="" width="1600" height="2000" data-lightbox-img>
  </div>
  <button type="button" class="icon-btn lightbox__close" data-close-dialog>{% render 'icon', name: 'close' %}<span class="visually-hidden">{{ 'general.close' | t }}</span></button>
  {%- if product.media.size > 1 -%}
    <button type="button" class="icon-btn lightbox__nav lightbox__nav--prev" data-lightbox-step="-1">{% render 'icon', name: 'arrow-left' %}<span class="visually-hidden">{{ 'general.previous' | t }}</span></button>
    <button type="button" class="icon-btn lightbox__nav lightbox__nav--next" data-lightbox-step="1">{% render 'icon', name: 'arrow' %}<span class="visually-hidden">{{ 'general.next' | t }}</span></button>
  {%- endif -%}
</dialog>

{%- comment -%} Variant data for naturel.js — prices pre-formatted by Shopify's money filter. {%- endcomment -%}
<script type="application/json" data-variants>
  [
    {%- for variant in product.variants -%}
      {%- capture price_html -%}{% render 'price', product: product, variant: variant %}{%- endcapture -%}
      {%- capture availability_html -%}{% render 'availability', variant: variant %}{%- endcapture -%}
      {%- assign v_edition = variant.metafields.custom.edition_number.value | default: product.metafields.custom.edition_number.value -%}
      {
        "id": {{ variant.id }},
        "options": {{ variant.options | json }},
        "available": {{ variant.available | json }},
        "media_id": {% if variant.featured_media %}{{ variant.featured_media.id }}{% else %}null{% endif %},
        "price": {{ variant.price | money | json }},
        "price_html": {{ price_html | strip | json }},
        "availability_html": {{ availability_html | strip | json }},
        "edition": {% if v_edition %}{{ v_edition | append: '' | json }}{% else %}null{% endif %}
      }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ]
</script>

<script type="application/ld+json">
  {
    "@context": "https://schema.org/",
    "@type": "Product",
    "name": {{ product.title | json }},
    "url": {{ request.origin | append: product.url | json }},
    {%- if first_image -%}
    "image": [{{ first_image | image_url: width: 1600 | prepend: 'https:' | json }}],
    {%- endif -%}
    "description": {{ product.description | strip_html | strip | json }},
    {%- if current_variant.sku != blank -%}"sku": {{ current_variant.sku | json }},{%- endif -%}
    "brand": { "@type": "Brand", "name": {{ product.vendor | default: shop.name | json }} },
    "offers": [
      {%- for variant in product.variants -%}
        {
          "@type": "Offer",
          {%- if variant.sku != blank -%}"sku": {{ variant.sku | json }},{%- endif -%}
          "availability": "http://schema.org/{% if variant.available %}InStock{% else %}SoldOut{% endif %}",
          "price": {{ variant.price | divided_by: 100.0 | json }},
          "priceCurrency": {{ cart.currency.iso_code | json }},
          "url": {{ request.origin | append: variant.url | json }}
        }{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    ]
  }
</script>

{% schema %}
{
  "name": "Fiche produit",
  "tag": "section",
  "class": "section-product",
  "blocks": [
    {
      "type": "title",
      "name": "Titre",
      "limit": 1,
      "settings": [
        { "type": "paragraph", "content": "Le surtitre vient du métachamp custom.series (ex. Coastal Series)." },
        { "type": "checkbox", "id": "show_vendor", "label": "Afficher la marque", "default": false }
      ]
    },
    { "type": "price", "name": "Prix", "limit": 1, "settings": [] },
    {
      "type": "edition",
      "name": "Édition limitée",
      "limit": 1,
      "settings": [
        { "type": "paragraph", "content": "Affiché seulement si le produit a les métachamps custom.edition_size et/ou custom.edition_number (produit ou variante)." }
      ]
    },
    { "type": "variant_picker", "name": "Sélecteur de variantes", "limit": 1, "settings": [] },
    {
      "type": "colorways",
      "name": "Autres coloris",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Titre", "default": "Coloris" },
        { "type": "collection", "id": "collection", "label": "Collection des coloris", "info": "Vide = première collection du produit. Couleur de la pastille : métachamp custom.swatch (sinon la photo)." }
      ]
    },
    {
      "type": "buy_buttons",
      "name": "Achat",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_dynamic_checkout",
          "label": "Paiement express",
          "info": "Shop Pay, Apple Pay, Google Pay, PayPal… selon Paramètres > Paiements.",
          "default": true
        }
      ]
    },
    { "type": "description", "name": "Description", "limit": 1, "settings": [] },
    {
      "type": "collapsible",
      "name": "Onglet repliable",
      "settings": [
        { "type": "text", "id": "heading", "label": "Titre", "default": "Composition" },
        {
          "type": "select",
          "id": "source",
          "label": "Contenu",
          "options": [
            { "value": "composition", "label": "Métachamp custom.composition" },
            { "value": "care", "label": "Métachamp custom.care" },
            { "value": "custom", "label": "Texte ci-dessous" }
          ],
          "default": "custom"
        },
        { "type": "richtext", "id": "content", "label": "Texte" },
        { "type": "page", "id": "page", "label": "Page (contenu ajouté)" },
        { "type": "checkbox", "id": "show_policies", "label": "Liens vers les politiques livraison et remboursement", "default": false },
        { "type": "checkbox", "id": "open", "label": "Ouvert par défaut", "default": false }
      ]
    },
    {
      "type": "text",
      "name": "Texte",
      "settings": [{ "type": "richtext", "id": "text", "label": "Texte" }]
    }
  ]
}
{% endschema %}
