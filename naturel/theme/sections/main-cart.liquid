<div class="container section--tight" data-cart-page>
  <div class="page-head">
    <h1 class="h1">{{ 'cart.title' | t }}</h1>
  </div>

  {%- if cart.item_count > 0 -%}
    <div class="cart-page">
      <form action="{{ routes.cart_url }}" method="post" id="CartPageForm" novalidate>
        {% render 'cart-items' %}
        <noscript><button type="submit" class="btn" style="margin-top: 24px;">{{ 'cart.update' | t }}</button></noscript>
      </form>
      <aside class="cart-page__summary" aria-label="{{ 'cart.summary' | t }}">
        {% render 'cart-summary', form_id: 'CartPageForm', id: 'page', show_dynamic: section.settings.show_dynamic %}
      </aside>
    </div>
  {%- else -%}
    <div class="cart-empty">
      {% render 'emblem', width: 52 %}
      <p class="h3">{{ 'cart.empty' | t }}</p>
      <a href="{{ routes.all_products_collection_url }}" class="btn">{{ 'cart.continue' | t }}</a>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Panier",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_dynamic",
      "label": "Boutons de paiement express",
      "info": "Apple Pay, Google Pay, Shop Pay, PayPal… selon les moyens activés dans Paramètres > Paiements.",
      "default": true
    }
  ]
}
{% endschema %}
