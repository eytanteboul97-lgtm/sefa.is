{%- assign collection = section.settings.collection -%}
<section class="section{% if section.settings.background != 'none' %} section--{{ section.settings.background }}{% endif %}" id="collection-{{ section.id }}">
  <div class="container">
    <div class="section-head section-head--split">
      <div class="stack-sm">
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow eyebrow--rule reveal">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="h2 reveal" style="--d: 1">{{ section.settings.heading | default: collection.title }}</h2>
        {%- if section.settings.text != blank -%}<div class="lede reveal" style="--d: 2; max-width: 52ch">{{ section.settings.text }}</div>{%- endif -%}
      </div>
      {%- if collection != blank and section.settings.show_link -%}
        <a href="{{ collection.url }}" class="link reveal" style="--d: 2">{{ 'collections.view_all' | t }} {% render 'icon', name: 'arrow' %}</a>
      {%- endif -%}
    </div>

    {%- if collection != blank and collection.products_count > 0 -%}
      <ul class="grid list-reset" role="list" style="--cols: {{ section.settings.columns }}">
        {%- for product in collection.products limit: section.settings.limit -%}
          <li>{% render 'product-card', product: product, index: forloop.index0, show_quick_add: section.settings.quick_add %}</li>
        {%- endfor -%}
      </ul>
    {%- else -%}
      <ul class="grid list-reset" role="list" style="--cols: {{ section.settings.columns }}">
        {%- for i in (1..section.settings.columns) -%}
          <li>
            <div class="card">
              <div class="card__media media">{% render 'placeholder', label: 'Choisissez une collection Shopify dans cette section' %}</div>
              <div class="card__info"><p class="card__title">—</p></div>
            </div>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Collection",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Produits, photos, prix et disponibilités viennent de Shopify."
    },
    { "type": "text", "id": "eyebrow", "label": "Surtitre", "default": "Coastal Series" },
    { "type": "text", "id": "heading", "label": "Titre", "info": "Vide = nom de la collection.", "default": "La collection" },
    { "type": "richtext", "id": "text", "label": "Texte" },
    { "type": "range", "id": "limit", "label": "Nombre de produits", "min": 2, "max": 24, "step": 1, "default": 10 },
    { "type": "range", "id": "columns", "label": "Colonnes (grand écran)", "min": 3, "max": 5, "step": 1, "default": 5 },
    { "type": "checkbox", "id": "quick_add", "label": "Ajout rapide (produits sans variante)", "default": true },
    { "type": "checkbox", "id": "show_link", "label": "Lien « Voir toute la collection »", "default": true },
    {
      "type": "select",
      "id": "background",
      "label": "Fond",
      "options": [
        { "value": "none", "label": "Sable" },
        { "value": "paper", "label": "Blanc cassé" },
        { "value": "beige", "label": "Beige chaud" }
      ],
      "default": "none"
    }
  ],
  "presets": [{ "name": "Collection" }]
}
{% endschema %}
