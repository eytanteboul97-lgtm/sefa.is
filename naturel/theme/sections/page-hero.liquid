<section class="hero hero--short hero--center on-media" data-hero>
  <div class="hero__media{% if section.settings.drift %} is-drifting{% endif %}">
    {%- if section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 2400 | image_tag: widths: '750, 1100, 1500, 1920, 2400', sizes: '100vw', loading: 'eager', fetchpriority: 'high' }}
    {%- else -%}
      {% render 'placeholder', tone: section.settings.placeholder_tone, label: section.settings.placeholder_label %}
    {%- endif -%}
  </div>
  <div class="hero__overlay" style="opacity: {{ section.settings.overlay | divided_by: 100.0 }}"></div>
  <div class="hero__content container">
    {%- if section.settings.eyebrow != blank -%}<p class="eyebrow hero__fade" style="color: inherit; --d: 0">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h1 class="h-display"><span class="hero__line" style="--d: 1"><span>{{ section.settings.heading | default: page.title }}</span></span></h1>
    {%- if section.settings.subheading != blank -%}<p class="hero__sub hero__fade" style="--d: 2">{{ section.settings.subheading }}</p>{%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Grande image de page",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Photographie" },
    { "type": "checkbox", "id": "drift", "label": "Mouvement lent", "default": true },
    { "type": "range", "id": "overlay", "label": "Voile", "min": 0, "max": 60, "step": 2, "unit": "%", "default": 24 },
    { "type": "text", "id": "eyebrow", "label": "Surtitre" },
    { "type": "text", "id": "heading", "label": "Titre", "info": "Vide = titre de la page." },
    { "type": "text", "id": "subheading", "label": "Sous-titre" },
    { "type": "text", "id": "placeholder_label", "label": "Description de l'image attendue (tant qu'aucune image n'est importée)", "default": "Photographie de paysage côtier" },
    {
      "type": "select", "id": "placeholder_tone", "label": "Ton du remplacement",
      "options": [{ "value": "ocean", "label": "Océan" }, { "value": "sand", "label": "Sable" }, { "value": "stone", "label": "Pierre" }],
      "default": "ocean"
    }
  ],
  "presets": [{ "name": "Grande image de page" }]
}
{% endschema %}
