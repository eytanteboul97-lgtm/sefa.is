<div class="container container--text section--tight" style="max-width: 480px">
  <h1 class="h1 text-center" style="margin-bottom: 20px">{{ 'customer.activate.title' | t }}</h1>
  <p class="text-center muted" style="margin-bottom: 32px">{{ 'customer.activate.text' | t }}</p>
  {%- form 'activate_customer_password' -%}
    {%- if form.errors -%}<div class="errors" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
    <div class="field"><label for="ActivatePassword">{{ 'customer.password' | t }}</label><input type="password" name="customer[password]" id="ActivatePassword" autocomplete="new-password" required></div>
    <div class="field"><label for="ActivatePasswordConfirm">{{ 'customer.password_confirm' | t }}</label><input type="password" name="customer[password_confirmation]" id="ActivatePasswordConfirm" autocomplete="new-password" required></div>
    <button type="submit" class="btn btn--solid btn--block">{{ 'customer.activate.submit' | t }}</button>
    <button type="submit" name="decline" class="btn btn--block" style="margin-top: 10px">{{ 'customer.activate.decline' | t }}</button>
  {%- endform -%}
</div>

{% schema %}
{ "name": "Activation du compte", "settings": [] }
{% endschema %}
