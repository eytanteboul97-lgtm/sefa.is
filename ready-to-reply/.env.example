# Copier ce fichier en .env.local (développement) ou renseigner ces variables
# dans l'interface Netlify (Site configuration → Environment variables).
# Ne jamais committer de valeurs réelles.

# URL publique du site, sans barre finale (balises canoniques, Open Graph, sitemap).
NEXT_PUBLIC_SITE_URL=https://www.exemple.fr

# Autoriser l'indexation par les moteurs de recherche. Laisser vide tant que
# les mentions légales, la politique de confidentialité et les coordonnées
# ne sont pas complétées et validées.
NEXT_PUBLIC_ALLOW_INDEXING=

# Webhook qui reçoit les demandes du formulaire (POST JSON) : Make, Zapier,
# n8n, CRM, fonction d'envoi d'e-mail… Sans cette variable, en production,
# le formulaire indique honnêtement que la demande n'a pas pu être envoyée.
CONTACT_WEBHOOK_URL=

# Facultatif : jeton envoyé dans l'en-tête `Authorization: Bearer <jeton>`
# pour que le webhook puisse vérifier l'origine des requêtes.
CONTACT_WEBHOOK_SECRET=
